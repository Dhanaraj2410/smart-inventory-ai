{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Django: check",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["manage.py", "check"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Django: test",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["manage.py", "test"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Django: migrate",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["manage.py", "migrate"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Django: runserver",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["manage.py", "runserver"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
